{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "pattern": "^B[0-9]{4}$",
      "type": "string"
    },
    "catalog_action": {
      "enum": [
        "EXISTING_ENTRY_SUFFICIENT",
        "EXISTING_ENTRY_NEEDS_CORRECTION",
        "ADD_CATALOG_ENTRY",
        "NO_SEPARATE_CATALOG_ENTRY",
        "INSUFFICIENT_BOOK_EVIDENCE"
      ],
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^E[0-9]{6}$",
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "family_action": {
      "enum": [
        "EXISTING_SEMANTIC_FAMILY",
        "NEW_SEMANTIC_FAMILY",
        "SOURCE_INSUFFICIENT_FOR_FAMILY"
      ],
      "type": "string"
    },
    "family_relations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence_ids": {
            "items": {
              "pattern": "^E[0-9]{6}$",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "rationale": {
            "minLength": 1,
            "type": "string"
          },
          "relation": {
            "enum": [
              "MEMBER_OF",
              "INSTANCE_OF",
              "RESTRICTS",
              "SEEDS",
              "REPRESENTS",
              "OBSERVES",
              "APPLIES",
              "EMULATES",
              "SOLVES",
              "COMPOSES",
              "ALIASES"
            ],
            "type": "string"
          },
          "target_id": {
            "pattern": "^(?:B[0-9]{4}|F[0-9]{4})$",
            "type": "string"
          },
          "target_kind": {
            "enum": [
              "CANDIDATE",
              "SEMANTIC_FAMILY"
            ],
            "type": "string"
          }
        },
        "required": [
          "relation",
          "target_kind",
          "target_id",
          "evidence_ids",
          "rationale"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "hostile_review_required": {
      "type": "boolean"
    },
    "proof_packets": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "nearest_candidate_ids": {
            "items": {
              "pattern": "^B[0-9]{4}$",
              "type": "string"
            },
            "type": "array",
            "uniqueItems": true
          },
          "non_preservation_witness": {
            "type": [
              "string",
              "null"
            ]
          },
          "obligations": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "argument": {
                  "minLength": 1,
                  "type": "string"
                },
                "evidence_ids": {
                  "items": {
                    "pattern": "^E[0-9]{6}$",
                    "type": "string"
                  },
                  "type": "array",
                  "uniqueItems": true
                },
                "obligation_id": {
                  "minLength": 1,
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "PROVED",
                    "NOT_APPLICABLE",
                    "SOURCE_INSUFFICIENT"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "obligation_id",
                "status",
                "evidence_ids",
                "argument"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "proof_case": {
            "enum": [
              "same_family",
              "specialization_preset_property_seed",
              "composition_hybrid",
              "representation_observer_application_emulation",
              "new_catalog_entry",
              "new_semantic_family",
              "source_insufficient"
            ],
            "type": "string"
          },
          "reopen_trigger": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "proof_case",
          "obligations",
          "nearest_candidate_ids",
          "non_preservation_witness",
          "reopen_trigger"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "rationale": {
      "minLength": 1,
      "type": "string"
    },
    "semantic_role": {
      "enum": [
        "NATIVE_TRANSITION_OR_GENERATOR",
        "STOCHASTIC_OR_BRANCHING_PROCESS",
        "INPUT_PROCESSOR_OR_TRANSDUCER",
        "RELATION_CONSTRAINT_OR_MODEL_SET",
        "IMMUTABLE_DEFINITION_OR_QUERY",
        "SPECIALIZATION_OR_PRESET",
        "PROPERTY_OR_RESTRICTION",
        "SEED_INPUT_OR_BOUNDARY_CLASS",
        "COMPOSITION_OR_HYBRID",
        "REPRESENTATION_CODEC_OR_OBSERVER",
        "APPLICATION_OR_EMULATION",
        "SOLVER_OR_NUMERICAL_METHOD",
        "DUPLICATE_OR_ALIAS",
        "SOURCE_INSUFFICIENT_ROLE"
      ],
      "type": "string"
    },
    "semantic_subtype": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "enum": [
            "SPECIALIZATION",
            "PRESET",
            "PROPERTY",
            "RESTRICTION",
            "SEED_CLASS",
            "INPUT_CLASS",
            "BOUNDARY_CLASS",
            "REPRESENTATION",
            "CODEC",
            "OBSERVER",
            "ANALYZER",
            "APPLICATION",
            "EMULATION",
            "SOLVER",
            "NUMERICAL_METHOD"
          ],
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "candidate_id",
    "catalog_action",
    "semantic_role",
    "semantic_subtype",
    "family_action",
    "family_relations",
    "rationale",
    "evidence_ids",
    "proof_packets",
    "hostile_review_required"
  ],
  "title": "Stage 20 classification row",
  "type": "object"
}
