{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_ids": {
      "items": {
        "pattern": "^B[0-9]{4}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "coverage_id": {
      "pattern": "^C[0-9]{4}$",
      "type": "string"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^E[0-9]{6}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "existing_t_ids": {
      "items": {
        "pattern": "^T(?:0[1-9]|[1-3][0-9]|4[0-5])$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "image_paths": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "proposed_t_ids": {
      "items": {
        "pattern": "^T[0-9]{2,}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "rationale": {
      "minLength": 1,
      "type": "string"
    },
    "reconciliation_result": {
      "enum": [
        "REDISCOVERED",
        "CORRECTION_REQUIRED",
        "PROPOSED_ADDITION",
        "NO_SEPARATE_ENTRY",
        "DUPLICATE_OR_ALIAS",
        "INSUFFICIENT_BOOK_EVIDENCE",
        "UNMATCHED_EXISTING_OBLIGATION"
      ],
      "type": "string"
    },
    "source_unit_ids": {
      "items": {
        "pattern": "^U[0-9]{6}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "coverage_id",
    "candidate_ids",
    "existing_t_ids",
    "proposed_t_ids",
    "source_unit_ids",
    "image_paths",
    "evidence_ids",
    "reconciliation_result",
    "rationale"
  ],
  "title": "Stage 19+ coverage join row",
  "type": "object"
}
